# Copy to .env (never commit it). Keys are read on the server only (/api/*).
# On Netlify, set these as site environment variables instead.
GEMINI_API_KEY=
QLOO_API_KEY=
# Stay22 affiliate id for the "Stay nearby" links (defaults to newaddy)
STAY22_AID=newaddy
# Optional
# QLOO_BASE_URL=https://hackathon.api.qloo.com
# GEMINI_MODEL=            (pin one model instead of the fallback chain)
# GEMINI_HEDGE_MS=         (ms before the next model in the chain is raced)
# GEMINI_TOTAL_MS=         (overall Gemini deadline in ms)
# QLOO_LOG_FILE=./qloo-calls.log   (one line per Qloo call; the key is never written)
